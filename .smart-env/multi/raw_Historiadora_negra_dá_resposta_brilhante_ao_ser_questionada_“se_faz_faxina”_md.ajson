itico.com.br/2017/07/racismo-reverso-nao-existe.html","line":60},{"title":"O diagnóstico de Florestan Fernandes sobre o racismo que precisa ser resgatado","target":"https://www.pragmatismopolitico.com.br/2017/06/diagnostico-florestan-fernandes-racismo-resgatado.html","line":61},{"title":"Precisamos exercer a habilidade da empatia na nossa rotina","target":"https://www.pragmatismopolitico.com.br/2017/06/precisamos-exercer-empatia-rotina.html","line":62},{"title":"Barroso pede desculpas após chamar Barbosa de “negro de 1ª linha”","target":"https://www.pragmatismopolitico.com.br/2017/06/barroso-pede-desculpas-apos-chamar-barbosa-de-negro-de-1a-linha.html","line":63},{"title":"Qual o legado da abolição da escravatura?","target":"https://www.pragmatismopolitico.com.br/2017/05/legado-abolicao-escravatura.html","line":64},{"title":"“Sou a doutoranda negra e fedida das frases do banheiro”","target":"https://www.pragmatismopolitico.com.br/2017/03/doutoranda-negra-fedida-frases-banheiro.html","line":65},{"title":"Twitter","target":"https://twitter.com/pragmatismo_","line":67},{"title":"Facebook","target":"https://www.facebook.com/PragmatismoPolitico?ref=hl","line":67}],"metadata":{"title":"Historiadora negra dá resposta brilhante ao ser questionada “se faz faxina”","source":"https://www.pragmatismopolitico.com.br/2017/07/historiadora-negra-questionada-faxina.html","author":["[[Luana Tolentino]]"],"published":"2017-07-19","created":"2026-05-03","description":"“Hoje uma senhora me parou na rua e perguntou se eu fazia faxina...”. Mestranda, historiadora e professora responde de maneira precisa questionamento","tags":["#clippings"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"raw/Historiadora negra dá resposta brilhante ao ser questionada “se faz faxina”.md"},
