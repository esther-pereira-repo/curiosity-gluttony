,0.03428525,-0.01812779,0.05908964,-0.06601974,-0.01077154,0.04965096,0.19349875,-0.06356633,0.01913314,-0.03396929,-0.03354875,0.01157873,0.08296599,-0.00630715,-0.04853264,0.02970198,0.04826979,-0.03188259,-0.00452087,0.00230371,-0.03876077,0.01481126,-0.05118458,-0.01753232,-0.064863,0.02623663,0.03175294,0.03417389,0.06969928,-0.02024444,-0.04709768,-0.04205868,0.00326146,0.00339151,0.02183841,0.01876133,0.01903798,0.00147755,0.01992946,0.0970543,-0.04273607,-0.01032157,-0.00807717,-0.02432408,0.00001396,-0.00195446,0.02376795,0.01461159,0.02267756],"last_embed":{"tokens":464,"hash":"841cb"}}},"last_read":{"hash":"841cb","at":1778195852388},"class_name":"SmartSource","last_import":{"mtime":1778195838024,"size":3452,"at":1778195851102,"hash":"841cb"},"blocks":{"#---frontmatter---":[1,10],"##Kyle Duffield":[11,12],"##Interactive Experience Creator":[13,16],"##Interactive Experience Creator#{1}":[15,16],"##[The Cyber Séance](https://www.kyleduffield.com/the-cyber-seance.html)":[17,68],"##[The Cyber Séance](https://www.kyleduffield.com/the-cyber-seance.html)#{1}":[19,68],"##[SOMO by Sonic Wear](https://www.kyleduffield.com/somo.html)":[69,78],"##[SOMO by Sonic Wear](https://www.kyleduffield.com/somo.html)#{1}":[71,78],"##[Hive](https://www.kyleduffield.com/hive.html)":[79,88],"##[Hive](https://www.kyleduffield.com/hive.html)#{1}":[81,88],"##[Chromastrobe](https://www.kyleduffield.com/chromastrobe.html)":[89,98],"##[Chromastrobe](https://www.kyleduffield.com/chromastrobe.html)#{1}":[91,98],"##[Echolocation](https://www.kyleduffield.com/echolocation.html)":[99,105],"##[Echolocation](https://www.kyleduffield.com/echolocation.html)#{1}":[101,105]},"outlinks":[{"title":"![image","target":"https://www.kyleduffield.com/assets/images/10.jpg","line":15},{"title":"The Cyber Séance","target":"https://www.kyleduffield.com/the-cyber-seance.html","line":17},{"title":"\n\nA cyberpunk-inspired interactive installation where visitors speak with an AI spirit that generates immersive narratives in real time.\n\n","target":"https://www.kyleduffield.com/the-cyber-seance.html","line":19},{"title":"Feed the Fires","target":"https://www.kyleduffield.com/feed-the-fires.html","line":23},{"title":"\n\nAn AI-driven installation rooted in Indigenous storytelling, created with the Ainu of Japan, where the spirit of fire carries your story to the spirit world.\n\n","target":"https://www.kyleduffield.com/feed-the-fires.html","line":25},{"title":"Superpump","target":"https://www.kyleduffield.com/superpump.html","line":29},{"title":"\n\nMultiplayer party game where participants compete using bicycle pumps as game controllers.\n\n","target":"https://www.kyleduffield.com/superpump.html","line":31},{"title":"I Have A Right","target":"https://www.kyleduffield.com/i-have-a-right.html","line":35},{"title":"\n\nA touch based interactive video mural created in collaboration with children.\n\n","target":"https://www.kyleduffield.com/i-have-a-right.html","line":37},{"title":"Schwister","target":"https://www.kyleduffield.com/schwister.html","line":41},{"title":"\n\nA light-up tabletop arcade game that combines Twister with the frenzy of Whack-A-Mole.\n\n","target":"https://www.kyleduffield.com/schwister.html","line":43},{"title":"Laser Equipped Annihilation Protocol","target":"https://www.kyleduffield.com/laser-equipped-annihilation-protocol.html","line":47},{"title":"\n\nA live-action gaming environment where the players are pitted against an ominous surveillance system.\n\n","target":"https://www.kyleduffield.com/laser-equipped-annihilation-protocol.html","line":49},{"title":"Terrors of the Breakfast Table","target":"https://www.kyleduffield.com/terrors-of-the-breakfast-table.html","line":53},{"title":"\n\nAn interactive experimental video where your breath unveils the narrative.\n\n","target":"https://www.kyleduffield.com/terrors-of-the-breakfast-table.html","line":55},{"title":"Panoptidrome","target":"https://www.kyleduffield.com/panoptidrome.html","line":59},{"title":"\n\nInteractive audio-video surveillance sculpture that 3D scans faces.\n\n","target":"https://www.kyleduffield.com/panoptidrome.html","line":61},{"title":"![SOMO by Sonic Wear (Photo by Asma Khanani Caporaletti) ","target":"https://www.kyleduffield.com/assets/images/somo.jpg","line":67},{"title":"SOMO by Sonic Wear","target":"https://www.kyleduffield.com/somo.html","line":69},{"title":"\n\nGenerate sound through dance and movement with wearable technology.\n\n","target":"https://www.kyleduffield.com/somo.html","line":71},{"title":"![image","target":"https://www.kyleduffield.com/assets/images/2.jpg","line":77},{"title":"Hive","target":"https://www.kyleduffield.com/hive.html","line":79},{"title":"\n\nMultichannel interactive speaker sculpture with a pulsating spatial sound composition.\n\n","target":"https://www.kyleduffield.com/hive.html","line":81},{"title":"![Chromastrobe","target":"https://www.kyleduffield.com/assets/images/chromastrobe.jpg","line":87},{"title":"Chromastrobe","target":"https://www.kyleduffield.com/chromastrobe.html","line":89},{"title":"\n\nStrobing video colour field that creates hallucinatory red, green, blue trails.\n\n","target":"https://www.kyleduffield.com/chromastrobe.html","line":91},{"title":"![image","target":"https://www.kyleduffield.com/assets/images/1.jpg","line":97},{"title":"Echolocation","target":"https://www.kyleduffield.com/echolocation.html","line":99},{"title":"\n\nInteractive surround sound and video sonar environment.\n\n","target":"https://www.kyleduffield.com/echolocation.html","line":101}],"metadata":{"title":"The Work of Kyle Duffield","source":"https://www.kyleduffield.com/","author":null,"published":null,"created":"2026-05-07","description":null,"tags":["#clippings"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:raw/The Work of Kyle Duffield.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"18z9fk9","at":1778195851101},"key":"raw/The Work of Kyle Duffield.md#---frontmatter---","lines":[1,10],"size":156,"outlinks":[],"class_name":"SmartBlock"},
