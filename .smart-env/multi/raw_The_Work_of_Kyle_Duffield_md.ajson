eduffield.com/i-have-a-right.html","line":21},{"title":"Schwister","target":"https://www.kyleduffield.com/schwister.html","line":25},{"title":"\n\nA light-up tabletop arcade game that combines Twister with the frenzy of Whack-A-Mole.\n\n","target":"https://www.kyleduffield.com/schwister.html","line":27},{"title":"Laser Equipped Annihilation Protocol","target":"https://www.kyleduffield.com/laser-equipped-annihilation-protocol.html","line":31},{"title":"\n\nA live-action gaming environment where the players are pitted against an ominous surveillance system.\n\n","target":"https://www.kyleduffield.com/laser-equipped-annihilation-protocol.html","line":33},{"title":"Terrors of the Breakfast Table","target":"https://www.kyleduffield.com/terrors-of-the-breakfast-table.html","line":37},{"title":"\n\nAn interactive experimental video where your breath unveils the narrative.\n\n","target":"https://www.kyleduffield.com/terrors-of-the-breakfast-table.html","line":39},{"title":"Panoptidrome","target":"https://www.kyleduffield.com/panoptidrome.html","line":43},{"title":"\n\nInteractive audio-video surveillance sculpture that 3D scans faces.\n\n","target":"https://www.kyleduffield.com/panoptidrome.html","line":45},{"title":"![SOMO by Sonic Wear (Photo by Asma Khanani Caporaletti) ","target":"https://www.kyleduffield.com/assets/images/somo.jpg","line":51}],"class_name":"SmartBlock"},
