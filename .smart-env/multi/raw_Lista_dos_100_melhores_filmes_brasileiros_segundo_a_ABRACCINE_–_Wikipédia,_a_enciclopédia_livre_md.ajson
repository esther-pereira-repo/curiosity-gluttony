do \"Festival de Gramado\"","line":9},{"title":"luxo","target":"https://pt.wikipedia.org/wiki/Luxo \"Luxo\"","line":9},{"title":"Amir Labaki","target":"https://pt.wikipedia.org/wiki/Amir_Labaki \"Amir Labaki\"","line":11},{"title":"Celso Sabadin","target":"https://pt.wikipedia.org/wiki/Celso_Sabadin \"Celso Sabadin\"","line":11},{"title":"Jean-Claude Bernardet","target":"https://pt.wikipedia.org/wiki/Jean-Claude_Bernardet \"Jean-Claude Bernardet\"","line":11},{"title":"João Batista de Brito","target":"https://pt.wikipedia.org/wiki/Jo%C3%A3o_Batista_de_Brito \"João Batista de Brito\"","line":11},{"title":"Pablo Villaça","target":"https://pt.wikipedia.org/wiki/Pablo_Villa%C3%A7a \"Pablo Villaça\"","line":11},{"title":"Rubens Ewald Filho","target":"https://pt.wikipedia.org/wiki/Rubens_Ewald_Filho \"Rubens Ewald Filho\"","line":11}],"class_name":"SmartBlock"},
